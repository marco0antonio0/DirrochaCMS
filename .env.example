# ---------------------------------------------------------------------------
# Credenciais do Firebase Admin (SERVIDOR)
# ---------------------------------------------------------------------------
# Todo acesso ao Firestore acontece no servidor via Admin SDK; o navegador nao
# recebe credencial nenhuma.
#
# 1. Gere a chave em:
#      Firebase Console > Configuracoes do projeto > Contas de servico
#      > Gerar nova chave privada
#
# 2. Converta o JSON para base64 numa UNICA linha (a private_key contem \n, que
#    quebram o parsing deste arquivo se colados crus):
#
#      Linux:    base64 -w0 caminho/para/service-account.json
#      macOS:    base64 -i caminho/para/service-account.json | tr -d '\n'
#      Windows:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("caminho\service-account.json"))
#
# 3. Cole o resultado abaixo e apague o arquivo JSON baixado.
#
# Nunca versione o JSON (o .gitignore ja bloqueia *adminsdk*.json).
FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_service_account_json

# ---------------------------------------------------------------------------
# Sessao
# ---------------------------------------------------------------------------
# Assina os tokens de sessao (HMAC). Minimo de 32 caracteres, exclusiva por
# ambiente. Trocar este valor invalida todas as sessoes ativas.
#
# GERE UMA CHAVE VALIDA COM:
#
#   npm run generate:secret
#
# Alternativas equivalentes:
#
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
SECRET_KEY=change_this_to_a_strong_random_secret_min_32_chars

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENV=development
